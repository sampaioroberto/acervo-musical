# Copie para .env.local e configure somente os parâmetros públicos.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Caminho de publicação: /nome-do-repositorio/ ou / para domínio próprio.
VITE_BASE_PATH=/
# true somente para publicar uma demonstração explícita, sem administração.
VITE_DEMO=false

